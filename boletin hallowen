      </div>
    </section>

    <!-- SECCIÓN 3: SUSPENSO Y MISTERIO -->
    <section class="seccion">
      <h2>Suspenso y misterio</h2>
      <div class="linea"></div>
      <div class="grid">

        <article class="tarjeta">
